{{template "base" .}}
{{define "title"}}{{.Commit.Summary}} - {{.Repo.RepoName}}@{{.CommitID}}{{end}}
{{define "meta"}}
<link rel="stylesheet" href="{{.Repo.RootRelative}}syntax.css" />
{{end}}

{{define "content"}}
  <h2>Commit <code>{{.CommitID}}</code></h2>

  <div class="flex justify-between flex-wrap">
    <div class="flex flex-1 items-center gap-xs">
      <span>{{.Commit.Author.Name}}</span>
      <span>&nbsp;&centerdot;&nbsp;</span>
      <span>{{.Commit.Author.When}}</span>
    </div>

    <div>
      {{- $num := len .Parents -}}
      {{- if eq $num 1 -}}
      parent <a href="{{index .ParentURLs 0}}">{{index .Parents 0}}</a>
      {{- else -}}
      parents
      {{- range $i, $p := .Parents}}
        <a href="{{index $.ParentURLs $i}}">{{.}}</a>{{if lt (add $i 1) $num}}, {{end}}
      {{- end}}
      {{- end}}
    </div>
  </div>

  <pre class="white-space-bs">{{.Commit.Message}}</pre>

  <div class="box mono">
    <div>
      <strong>{{.Diff.NumFiles}}</strong> files changed,&nbsp;
      <span class="color-green">+{{.Diff.TotalAdditions}}</span>,
      <span class="color-red">-{{.Diff.TotalDeletions}}</span>
    </div>

    <div>
    {{range .Diff.Files}}
      <div class="my">
        <span>{{.FileType}}</span>
        <a href="#diff-{{.Name}}">{{.Name}}</a>
      </div>
    {{end}}
    </div>
  </div>

  {{range .Diff.Files}}
    <div id="diff-{{.Name}}" class="box sticky border-visited flex items-center justify-between mono py">
      <div class="flex-1">
        <span>{{.FileType}} {{if eq .FileType "R"}}{{.OldName}} => {{end}}</span>
        <a href="#diff-{{.Name}}">{{.Name}}</a>
      </div>

      <div style="width: 100px; text-align: right;">
        <span class="color-green">+{{.NumAdditions}}</span>,
        <span class="color-red">-{{.NumDeletions}}</span>
      </div>
    </div>

    {{.Content}}
  {{end}}
{{end}}
